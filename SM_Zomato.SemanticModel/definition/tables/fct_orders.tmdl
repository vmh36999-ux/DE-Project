table fct_orders
	lineageTag: c06a5bd2-42aa-4fb1-a1a7-cdb46a89fecc
	sourceLineageTag: [staging].[fct_orders]

	measure 'Total Revenue' =
			
			SUM(fct_orders[sales_amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 35fbb7e1-cef6-4631-b1aa-1de7dbc4c0fb

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Orders' =
			
			COUNTROWS(fct_orders)
		formatString: 0
		lineageTag: f595f1e3-fda0-44b3-8446-90225548ffc7

		changedProperty = Name

	measure 'Average Order Value' =
			
			DIVIDE(
			    [Total Revenue],
			    [Total Orders]
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 9cd52c09-4c3d-408f-96b2-e12aa6bee75c

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Active Customers' =
			
			DISTINCTCOUNT(fct_orders[customer_id])
		formatString: 0
		lineageTag: 51faea83-89c4-47d8-8d70-e3fc4f7509ac

		changedProperty = Name

	measure 'Total Discount' =
			
			SUM(fct_orders[discount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 6e83c771-d8c3-4642-a8c7-ca1aedd3fa19

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Delivery Fee' =
			
			SUM(fct_orders[delivery_fee])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 77912824-6768-4fb0-a86c-03643f14e7fa

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total GST' =
			
			SUM(fct_orders[gst])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: e7d00f74-8da5-4d21-a495-9e5804e93931

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Subtotal' =
			
			SUM(fct_orders[subtotal])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 80d76ffe-d472-444b-9acc-0c753a43d7c6

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue per Customer' =
			
			DIVIDE(
			    [Total Revenue],
			    [Active Customers]
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 162134cf-3b9c-41d4-bc65-c82c1616575f

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Average Delivery Time' =
			
			AVERAGE(fct_orders[delivery_time_min])
		lineageTag: 0672ec27-be1d-48e1-8ed1-eb11565ed125

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'On Time Orders' =
			
			CALCULATE(
			    [Total Orders],
			    fct_orders[delivery_time_min] <= 30
			)
		formatString: 0
		lineageTag: 568e3896-a44f-4c95-b732-bf0bacdbb728

		changedProperty = Name

	measure 'Late Orders' =
			
			CALCULATE(
			    [Total Orders],
			    fct_orders[delivery_time_min] > 30
			)
		formatString: 0
		lineageTag: 1c515241-8414-4ddb-b19a-bf3da4ce859c

		changedProperty = Name

	measure 'On Time Rate' =
			
			DIVIDE(
			    [On Time Orders],
			    [Total Orders]
			)
		lineageTag: d8149fe1-4b96-48a8-8499-bdf94a5db7d3

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Rate' =
			
			DIVIDE(
			    [Late Orders],
			    [Total Orders]
			)
		lineageTag: a5098781-b2c2-4b2c-81ab-95e8ea9fb6fe

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'P50 Delivery Time' =
			
			PERCENTILEX.INC(
			    FILTER(
			        fct_orders,
			        NOT ISBLANK(fct_orders[delivery_time_min])
			    ),
			    fct_orders[delivery_time_min],
			    0.5
			)
		lineageTag: d588f13a-4066-40ee-90ab-7d0dc0c2addb

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'P90 Delivery Time' =
			
			PERCENTILEX.INC(
			    FILTER(
			        fct_orders,
			        NOT ISBLANK(fct_orders[delivery_time_min])
			    ),
			    fct_orders[delivery_time_min],
			    0.9
			)
		lineageTag: 9ae9715e-a9bb-4304-b9c1-af9e9b73053f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

