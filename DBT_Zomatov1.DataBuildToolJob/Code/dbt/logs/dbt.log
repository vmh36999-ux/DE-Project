        CREATE TABLE [WH_Zomato].[staging].[mart_restaurant_performance__dbt_tmp]
        
        AS select
    order_date,
    restaurant_city as city,

    count(distinct order_id) as total_orders,

    avg(delivery_time_min) as average_delivery_time_min,
    sum(
        when delivery_time_min <= 30 then 1 else 0 end
    ) as orders_delivered_on_time,
    sum(
        when delivery_time_min > 30 then 1 else 0 end
    ) as orders_delivered_late,
    cast(
        100.0 *
        sum(
            case
                when delivery_time_min <= 30 then 1
                else 0
            end
        )
        / nullif(count(delivery_time_min), 0)
        as decimal(5,2)
    ) as on_time_rate
from [WH_Zomato].[staging].[stg_orders]
where delivery_time_min is not null
group by
    order_date,
    restaurant_city

    

  
  
